{
  "version": 1,
  "field-max-zoom": 15,
  "layers": [
    {
      "id": "water",
      "type": "fill",
      "source-layer": "water",
      "paint": {
        "fill-color": "#122a5caa"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source-layer": "building",
      "minzoom": 13,
      "filter": {
        "any": [
          {
            "has": "name"
          },
          {
            "in": {
              "property": "building",
              "values": [
                "commercial",
                "industrial",
                "retail",
                "warehouse",
                "hospital",
                "school",
                "university",
                "college",
                "stadium",
                "hotel",
                "apartments",
                "church",
                "temple",
                "mosque",
                "public",
                "civic",
                "government",
                "train_station",
                "hangar"
              ]
            }
          },
          {
            "zoom": {
              "op": ">=",
              "value": 15
            }
          }
        ]
      },
      "paint": {
        "fill-color": "#785c3caa"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source-layer": "roads",
      "filter": {
        "any": [
          {
            "all": [
              {
                "zoom": {
                  "op": "<",
                  "value": 10
                }
              },
              {
                "in": {
                  "property": "highway",
                  "values": [
                    "motorway",
                    "trunk"
                  ]
                }
              }
            ]
          },
          {
            "all": [
              {
                "zoom": {
                  "op": ">=",
                  "value": 10
                }
              },
              {
                "zoom": {
                  "op": "<",
                  "value": 12
                }
              },
              {
                "in": {
                  "property": "highway",
                  "values": [
                    "motorway",
                    "trunk",
                    "primary"
                  ]
                }
              }
            ]
          },
          {
            "all": [
              {
                "zoom": {
                  "op": ">=",
                  "value": 12
                }
              },
              {
                "zoom": {
                  "op": "<",
                  "value": 13
                }
              },
              {
                "in": {
                  "property": "highway",
                  "values": [
                    "motorway",
                    "trunk",
                    "primary",
                    "secondary"
                  ]
                }
              }
            ]
          },
          {
            "all": [
              {
                "zoom": {
                  "op": ">=",
                  "value": 13
                }
              },
              {
                "zoom": {
                  "op": "<",
                  "value": 14
                }
              },
              {
                "in": {
                  "property": "highway",
                  "values": [
                    "motorway",
                    "trunk",
                    "primary",
                    "secondary",
                    "tertiary"
                  ]
                }
              }
            ]
          },
          {
            "all": [
              {
                "zoom": {
                  "op": ">=",
                  "value": 14
                }
              },
              {
                "zoom": {
                  "op": "<",
                  "value": 15
                }
              },
              {
                "in": {
                  "property": "highway",
                  "values": [
                    "motorway",
                    "trunk",
                    "primary",
                    "secondary",
                    "tertiary",
                    "residential",
                    "unclassified",
                    "living_street"
                  ]
                }
              }
            ]
          },
          {
            "zoom": {
              "op": ">=",
              "value": 15
            }
          }
        ]
      },
      "paint": {
        "line-color": "#ffb833e6",
        "line-width-ramp": [
          12,
          1.05,
          16,
          3.15
        ]
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "paint": {
        "point-anchor": "bottom",
        "point-image": {
          "match": {
            "property": "kind",
            "cases": {
              "place:city": "star",
              "place:town": "star",
              "place:district": "star",
              "place:suburb": "star",
              "railway:station": "square",
              "aeroway:aerodrome": "diamond",
              "tourism:attraction": "triangle",
              "tourism:museum": "triangle",
              "leisure:park": "triangle",
              "amenity:hospital": "pin"
            },
            "default": "circle"
          }
        },
        "point-color": "#ffd24df5"
      }
    }
  ]
}
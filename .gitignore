# Build outputs
build/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dll

# Android / Gradle generated files
.gradle/
**/.gradle/
**/.cxx/
**/build/
*.apk

# Local IDE and OS files
.DS_Store
.idea/
.vscode/

# Codex task orchestrator runtime state
.codex/task-state/*
!.codex/task-state/.gitkeep

# 参考项目源码本地克隆(CLAUDE.md .ref/ 约定),不入库
.ref/
scaffold/.ref/

# CTest 运行产物(每次 ctest 重新生成,无保留价值)
Testing/

# scaffold 本地中间产物:tmp/osm 等抽取数据 255MB,纯本地不入库。
# ⚠️ 只忽略 scaffold/tmp,**不要**写成裸 tmp/ —— 仓库根的 tmp/ab-fps/*.log 是
# 刻意入库的 A/B 基线(73 文件/38MB),一条裸规则会把它们连带藏掉。
scaffold/tmp/

# 仓库卫生(project-health-audit 2026-07-17):一次性调试/构建产物不入库。
# 已跟踪文件需 git rm --cached 才能移出;这里只防复发。
.run_output*.log
/click-*.whl
/glm-*.tar.gz

# 仓库根 tmp:除刻意入库的 tmp/ab-fps A/B 基线外,其余调试截图/日志/样本忽略。
/tmp/*
!/tmp/ab-fps/
!/tmp/ab-fps/**

# scaffold 调试截图与像素检查脚本(均为一次性产物,含损坏文件 screenshot2.png;)
scaffold/check_png*.py
scaffold/screenshot*.png
scaffold/screenshot2.png;
scaffold/test_via_shell.png
